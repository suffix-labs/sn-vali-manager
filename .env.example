# StarkNet Multi-Validator Node Configuration

# ==============================================================================
# PATHFINDER NODE CONFIGURATION
# ==============================================================================
PATHFINDER_ETHEREUM_API_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY_HERE

# ==============================================================================
# SUFFIX VALIDATOR CONFIGURATION (Local Signing)
# ==============================================================================
# Ethereum address for suffix validator staker operational account
SUFFIX_VALIDATOR_STAKER_OPERATIONAL_ADDRESS=0x1234567890123456789012345678901234567890

# Private key for suffix validator operational account (used for local signing)
SUFFIX_VALIDATOR_OPERATIONAL_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Remote signer URL for suffix validator (if using remote signing instead of local)
# SUFFIX_VALIDATOR_REMOTE_SIGNER_URL=https://your-remote-signer.example.com

# ==============================================================================
# ETHCHI VALIDATOR CONFIGURATION (Local Signing)
# ==============================================================================
# Ethereum address for ethchi validator staker operational account
ETHCHI_VALIDATOR_STAKER_OPERATIONAL_ADDRESS=0x1234567890123456789012345678901234567890

# Private key for ethchi validator operational account (used for local signing)
ETHCHI_VALIDATOR_OPERATIONAL_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Remote signer URL for ethchi validator (if using remote signing instead of local)
# ETHCHI_VALIDATOR_REMOTE_SIGNER_URL=https://your-remote-signer.example.com

# ==============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# ==============================================================================
# To enable Telegram alerts and daily summaries:
# 1. Create a bot via @BotFather on Telegram
# 2. Get your bot token from BotFather
# 3. Start a chat with your bot and get your chat ID
#    (send a message to your bot, then visit:
#    https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates)
#
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=123456789

# ==============================================================================
# REWARD CLAIMING CONFIGURATION
# ==============================================================================
# StarkNet RPC URL for claiming rewards (can be different from validator node)
STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io

# Suffix Validator Staking Info
# The staker address is your main validator identity on the staking contract
SUFFIX_STAKER_ADDRESS=0xYOUR_SUFFIX_STAKER_ADDRESS
# The reward account receives claimed rewards (can be same as staker or different)
# This account will sign the claim_rewards transaction
SUFFIX_REWARD_ACCOUNT_ADDRESS=0xYOUR_SUFFIX_REWARD_ACCOUNT_ADDRESS
SUFFIX_REWARD_ACCOUNT_PRIVATE_KEY=0xYOUR_SUFFIX_REWARD_ACCOUNT_PRIVATE_KEY
# Set to 'false' to skip this validator when running claim script
SUFFIX_CLAIM_ENABLED=true

# Ethchi Validator Staking Info
ETHCHI_STAKER_ADDRESS=0xYOUR_ETHCHI_STAKER_ADDRESS
ETHCHI_REWARD_ACCOUNT_ADDRESS=0xYOUR_ETHCHI_REWARD_ACCOUNT_ADDRESS
ETHCHI_REWARD_ACCOUNT_PRIVATE_KEY=0xYOUR_ETHCHI_REWARD_ACCOUNT_PRIVATE_KEY
ETHCHI_CLAIM_ENABLED=true

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================
# Logging levels for all services (debug, info, warn, error)
RUST_LOG=info
PATHFINDER_LOG_LEVEL=info
