{
  "name": "starknet-claim-rewards",
  "version": "1.0.0",
  "description": "Automated StarkNet validator reward claiming",
  "main": "claim-rewards.js",
  "type": "module",
  "scripts": {
    "claim": "node claim-rewards.js",
    "claim:dry-run": "DRY_RUN=true node claim-rewards.js",
    "staking-data": "node get-staking-data.mjs",
    "web": "cd web && npm run dev",
    "docker:build": "docker build -t starknet-staking-reporter .",
    "docker:run": "docker run --rm starknet-staking-reporter"
  },
  "dependencies": {
    "starknet": "6.11.0",
    "dotenv": "16.4.5"
  }
}
